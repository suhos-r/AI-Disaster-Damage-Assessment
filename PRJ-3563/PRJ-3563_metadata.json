ommons Attribution", "nhEvent": "", "nhTypes": [{"id": "hurricane/tropical storm", "name": "Hurricane/Tropical Storm"}], "dataType": {"id": "image", "name": "Image"}, "fileObjs": [], "fileTags": [{"path": "/PRJ-3563/images", "tagName": "Image"}, {"path": "/PRJ-3563/masks", "tagName": "Data"}, {"path": "/PRJ-3563/Ida-BD_description.pdf", "tagName": "README"}], "keywords": ["Building damage", "Hurricane", "Satellite imagery", "Post-disaster assessment"], "nhEvents": [], "dataTypes": [{"id": "image", "name": "Image"}], "projectId": "PRJ-3563", "tombstone": false, "facilities": [], "nhLatitude": "", "nhLocation": "", "description": "Ida-BD is a dataset with 87 pre- and post-disaster satellite imagery pairs with a very high resolution (0.5m/pixel) from Hurricane Ida 2021 in Louisiana, USA. Ida-BD was obtained from the WorldView-2 (WV2) satellite with very high-resolution images taken in Nov. 2020 and Jul. 2021 for pre-disaster and Sep. 2021 for post-disaster. The satellite imagery was collected close to New Orleans city in Louisiana, USA, one of the most impacted areas during Hurricane Ida in late Aug. 2021. Similar to the xBD dataset, we use polygons to represent building segments and provide four damage categories. All annotations were done by the in-house team with quality control.", "nhLongitude": "", "projectType": "other", "teamMembers": [], "awardNumbers": [], "guestMembers": [{"inst": "Texas A&M University", "user": "guestAliM0", "email": "amostafavi@civil.tamu.edu", "fname": "Ali", "guest": true, "lname": "Mostafavi", "order": 3}, {"inst": "Simon Fraser University", "user": "guestNavjotK1", "email": "navjot_kaur_4@sfu.ca", "fname": "Navjot", "guest": true, "lname": "Kaur", "order": 1}, {"inst": "Simon Fraser University", "user": "guestAliM2", "email": "a.mahdavi.amiri@gmail.com", "fname": "Ali", "guest": true, "lname": "Mahdavi-Amiri", "order": 2}], "hazmapperMaps": [], "referencedData": [], "associatedProjects": []}, "status": "published", "version": 1, "basePa